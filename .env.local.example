## Get a free key at https://www.robotevents.com/api/v2 (log in, then Developer > API tokens)
ROBOTEVENTS_TOKEN=

## Supabase project (Project Settings -> API). Powers accounts, teams, and course progress.
## Without these set, sign-in/progress features show a "not configured" message instead of failing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
